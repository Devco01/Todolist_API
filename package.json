    "postinstall": "npm run build",
    "init-blob": "node scripts/init-blob.js"
  },
  "dependencies": {
    "axios": "^1.5.0",
    "cors": "^2.8.5",
    "dotenv": "^16.0.3",
    "express": "^4.18.2",
    "mongoose": "^7.0.0",
    "node-cron": "^3.0.3",
    "nodemailer": "^6.10.1",
    "nodemailer-sendgrid": "^1.0.3",
    "nodemailer-sendgrid-transport": "^0.2.0",
    "vue": "^3.3.4",
    "vue-router": "^4.2.4",
    "vuex": "^4.1.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^4.3.4",
    "@vue/compiler-sfc": "^3.3.4",
    "concurrently": "^8.2.1",
    "nodemon": "^3.0.1",
    "vite": "^4.4.9"
  },
  "engines": {
    "node": ">=16.0.0"
