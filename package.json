{
  "name": "todolist",
  "version": "1.0.0",
  "scripts": {
    "dev": "vite",
    "build": "npm run vercel-build",
    "serve": "node api/index.js",
    "dev:all": "concurrently \"npm run dev\" \"npm run dev:api\"",
