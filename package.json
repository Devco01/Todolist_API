{
  "name": "todolist-api",
  "version": "1.0.0",
  "description": "Application TodoList avec frontend Vue.js et API Express",
  "main": "api/index.js",
  "scripts": {
    "dev": "vite",
    "start": "NODE_ENV=production node api/index.js",
    "build": "vite build",
    "prebuild": "node check-deployment.js",
    "vercel-build": "node check-deployment.js && vite build",
    "api": "node api/index.js",
    "dev:all": "concurrently \"npm run dev\" \"npm run api\"",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "dependencies": {
    "@sendgrid/mail": "^7.7.0",
    "axios": "^1.9.0",
    "bcrypt": "^5.1.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^4.18.2",
    "express-session": "^1.18.1",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^7.3.1",
    "node-cron": "^3.0.2",
    "nodemailer": "^6.9.3",
    "pg": "^8.15.6",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.35.1",
    "vue": "^3.3.4",
    "vue-router": "^4.2.4",
    "vuex": "^4.1.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^4.3.4",
    "concurrently": "^8.2.1",
    "vite": "^4.4.9"
  },
  "engines": {
    "node": ">=14.x"
  },
  "keywords": [
    "todo",
    "api",
    "notification",
    "vue"
  ],
  "author": "",
  "license": "ISC",
  "files": [
    "api/**/*",
    ".env",
    "check-deployment.js"
  ]
}
